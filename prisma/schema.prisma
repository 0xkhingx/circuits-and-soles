generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catalog MVP: no Listing/Review/Message — v2 roadmap.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
  favorites Favorite[]
}

model Product {
  id          String  @id
  brand       String
  name        String
  price       Int // kobo / cents — display as ₦
  sizes       String[]
  condition   String
  verified    Boolean @default(false)
  isNewDrop   Boolean @default(false)
  image       String
  description String
  favorites   Favorite[]
  orders      OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  status    String      @default("pending") // pending | paid | fulfilled
  channel   String      @default("whatsapp") // whatsapp | stripe_test
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  size      String
  price     Int
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Story {
  slug     String @id
  headline String
  category String
  readTime String
  image    String
  excerpt  String
  body     String?
}
